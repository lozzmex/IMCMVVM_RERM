<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IMCMVVM_RERM.Views.ImcPage"
             Title="ImcPage">
    <VerticalStackLayout Padding=" 24" Spacing="16">
        <Label Text="Calcular IMC"
            FontSize="26"
               FontAttributes="Bold"/>

        <Label Text="Peso en Likogramos"/>
        <Entry Placeholder="Ejemplo: 70"
               Keyboard="Numeric"
               Text="{Binding PesoT, Mode=TwoWay}"/>


        <Label Text="Altura en metros"/>
        <Entry Placeholder="Ejemplo: 1.75"
               Keyboard="Numeric"
               Text="{Binding EstaturaT, Mode=TwoWay}"/>

        <Button  Text="Calcular IMC"
                 Command="{Binding CalcularCommand}"/>

        <Label Text="{Binding Resultado}"/>
    </VerticalStackLayout>
</ContentPage>